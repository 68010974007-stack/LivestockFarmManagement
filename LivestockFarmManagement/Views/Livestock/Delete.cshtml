@model LivestockFarmManagement.Models.Livestock

@{
    ViewData["Title"] = "ยืนยันการลบข้อมูล";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card card-custom p-4 text-center border-0 shadow-sm">
            <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center text-danger"
                 style="width: 70px; height: 70px; background-color: var(--pastel-rose);">
                <i class="bi bi-exclamation-triangle-fill fs-2"></i>
            </div>

            <h4 class="fw-bold text-dark mb-2">ยืนยันการลบข้อมูล?</h4>
            <p class="text-muted fs-7 mb-4">
                คุณกำลังจะลบข้อมูลของ <strong class="text-dark">@Model.Name (#@Model.Code)</strong> การดำเนินการนี้ไม่สามารถยกเลิกได้
            </p>

            <form asp-action="Delete" method="post" class="d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger flex-grow-1 py-2.5 fw-bold rounded-3">
                    <i class="bi bi-trash me-1"></i> ยืนยันลบ
                </button>
                <button type="button" onclick="history.back()" class="btn btn-light border flex-grow-1 py-2.5 fw-bold text-secondary rounded-3">
                    <i class="bi bi-arrow-left me-1"></i> ยกเลิก / ย้อนกลับ
                </button>
            </form>
        </div>
    </div>
</div>