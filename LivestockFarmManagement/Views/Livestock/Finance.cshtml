@model IEnumerable<LivestockFarmManagement.Models.FinancialTransaction>

@{
    ViewData["Title"] = "บันทึกรายรับ-รายจ่ายฟาร์ม";
    var totalIncome = Model.Where(x => x.TransactionType == "รายรับ").Sum(x => x.Amount);
    var totalExpense = Model.Where(x => x.TransactionType == "รายจ่าย").Sum(x => x.Amount);
    var balance = totalIncome - totalExpense;
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 bg-success bg-opacity-10 border-0">
            <span class="text-success fw-bold">รายรับรวม</span>
            <h3 class="fw-bold text-success m-0">+@totalIncome.ToString("N0") ฿</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 bg-danger bg-opacity-10 border-0">
            <span class="text-danger fw-bold">รายจ่ายรวม</span>
            <h3 class="fw-bold text-danger m-0">-@totalExpense.ToString("N0") ฿</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 bg-primary bg-opacity-10 border-0">
            <span class="text-primary fw-bold">คงเหลือสุทธิ</span>
            <h3 class="fw-bold text-primary m-0">@balance.ToString("N0") ฿</h3>
        </div>
    </div>
</div>

<div class="card card-custom p-4 border-0 shadow-sm mb-4">
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle me-1 text-success"></i> บันทึกรายการใหม่</h5>
    <form asp-action="AddTransaction" method="post" class="row g-3">
        <div class="col-md-3">
            <select name="TransactionType" class="form-select bg-light">
                <option value="รายรับ">รายรับ (ขายสัตว์/ผลผลิต)</option>
                <option value="รายจ่าย">รายจ่าย (อาหาร/ยา/ดูแล)</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="Category" class="form-control bg-light" placeholder="หมวดหมู่ (เช่น ค่าอาหาร)" required />
        </div>
        <div class="col-md-3">
            <input type="number" step="0.01" name="Amount" class="form-control bg-light" placeholder="จำนวนเงิน (บาท)" required />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-pastel-primary w-100 fw-bold">บันทึกรายการ</button>
        </div>
    </form>
</div>

<div class="card card-custom p-4 border-0 shadow-sm">
    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-list-check me-1"></i> ประวัติรายการการเงิน</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>วันที่</th>
                    <th>ประเภท</th>
                    <th>หมวดหมู่</th>
                    <th>จำนวนเงิน</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(item.TransactionType == "รายรับ" ? "bg-success" : "bg-danger")">
                                @item.TransactionType
                            </span>
                        </td>
                        <td>@item.Category</td>
                        <td class="fw-bold @(item.TransactionType == "รายรับ" ? "text-success" : "text-danger")">
                            @(item.TransactionType == "รายรับ" ? "+" : "-")@item.Amount.ToString("N0") ฿
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>