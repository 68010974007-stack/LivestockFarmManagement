<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Farm System</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --pastel-bg: #f4f8f5;
            --pastel-green-primary: #2e7d32;
            --pastel-green-light: #e8f5e9;
            --pastel-green-card: #f1f8e9;
            --pastel-mint: #a5d6a7;
            --pastel-amber: #fff8e1;
            --pastel-rose: #ffebee;
            --pastel-blue: #e3f2fd;
        }

        body {
            font-family: 'Kanit', sans-serif;
            background-color: var(--pastel-bg);
            color: #374151;
        }

        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 2px solid var(--pastel-green-light);
            box-shadow: 0 4px 15px rgba(46, 125, 50, 0.05);
        }

        .card-custom {
            border: none;
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
        }

            .card-custom:hover {
                transform: translateY(-4px);
                box-shadow: 0 15px 30px rgba(46, 125, 50, 0.1);
            }

        .badge-pastel-green {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .badge-pastel-amber {
            background-color: #fff3cd;
            color: #664d03;
        }

        .badge-pastel-rose {
            background-color: #f8d7da;
            color: #842029;
        }

        .badge-pastel-blue {
            background-color: #cff4fc;
            color: #055160;
        }

        .btn-pastel-primary {
            background-color: var(--pastel-green-primary);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            padding: 10px 20px;
            transition: all 0.2s ease;
        }

            .btn-pastel-primary:hover {
                background-color: #1b5e20;
                color: white;
                box-shadow: 0 5px 15px rgba(46, 125, 50, 0.2);
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 42px; height: 42px; background-color: var(--pastel-green-light); color: var(--pastel-green-primary);">
                    <i class="bi bi-tree-fill fs-5"></i>
                </div>
                <div>
                    <span class="fw-bold fs-5 text-success d-block lh-1">Fresh Farm Management</span>
                    <small class="text-muted fw-light" style="font-size: 11px;">ระบบบริหารจัดการฟาร์มปศุสัตว์สดใส</small>
                </div>
            </a>

            <!-- Navigation Links & Action Buttons -->
            <div class="ms-auto d-flex align-items-center gap-2">
                <a asp-controller="Livestock" asp-action="Index" class="btn btn-light border text-success fw-bold shadow-sm">
                    <i class="bi bi-speedometer2 me-1"></i> แดชบอร์ด
                </a>

                <!-- 💰 เมนูระบบรายรับ-รายจ่าย -->
                <a asp-controller="Livestock" asp-action="Finance" class="btn btn-light border text-primary fw-bold shadow-sm">
                    <i class="bi bi-wallet2 me-1"></i> รายรับ-รายจ่าย
                </a>

                <!-- ⚙️ ปุ่มเมนูจัดการระบบ (Admin) -->
                <a asp-controller="Admin" asp-action="Index" class="btn btn-light border text-dark fw-bold shadow-sm">
                    <i class="bi bi-gear-fill me-1 text-secondary"></i> จัดการระบบ (Admin)
                </a>

                <a asp-controller="Livestock" asp-action="Create" class="btn btn-pastel-primary shadow-sm ms-1">
                    <i class="bi bi-plus-lg me-1"></i> เพิ่มสัตว์เลี้ยงใหม่
                </a>

                <!-- 🚪 ปุ่มออกจากระบบ (Logout) เพิ่มใหม่ -->
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger fw-bold shadow-sm ms-1" onclick="return confirm('คุณต้องการออกจากระบบใช่หรือไม่?');">
                    <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container py-4 flex-grow-1">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="bg-white border-top py-3 text-center text-muted fs-7">
        <div class="container">
            <small>© 2026 Fresh Natural Livestock Management — สดใส สะอาดตา ใช้งานง่าย</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>