@model IEnumerable<LivestockFarmManagement.Models.UserAccount>
@{
    ViewData["Title"] = "จัดการผู้ใช้งาน - Admin";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success m-0"><i class="bi bi-people-fill me-2"></i>ระบบจัดการผู้ใช้งาน (User Management)</h3>
            <small class="text-muted">จัดการบัญชีผู้ใช้งาน สิทธิ์ และสถานะการเข้าสู่ระบบ</small>
        </div>
        <a asp-action="Index" class="btn btn-light border text-secondary fw-bold rounded-pill"><i class="bi bi-arrow-left me-1"></i> กลับหน้า Admin</a>
    </div>

    <div class="row g-4">
        <!-- ฟอร์มเพิ่มผู้ใช้ใหม่ -->
        <div class="col-md-4">
            <div class="card card-custom p-4 border-0 shadow-sm">
                <h5 class="fw-bold text-success mb-3"><i class="bi bi-person-plus-fill me-2"></i>เพิ่มผู้ใช้งานใหม่</h5>
                <form asp-action="CreateUser" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">ชื่อผู้ใช้งาน (Username)</label>
                        <input name="Username" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">รหัสผ่าน (Password)</label>
                        <input name="Password" type="password" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">ชื่อ - นามสกุล</label>
                        <input name="FullName" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">สิทธิ์การใช้งาน (Role)</label>
                        <select name="Role" class="form-select rounded-3">
                            <option value="Admin">Admin (ผู้ดูแลระบบ)</option>
                            <option value="Staff">Staff (พนักงานประจำฟาร์ม)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold rounded-pill py-2"><i class="bi bi-check-circle me-1"></i> บันทึกผู้ใช้ใหม่</button>
                </form>
            </div>
        </div>

        <!-- ตารางแสดงรายชื่อผู้ใช้ -->
        <div class="col-md-8">
            <div class="card card-custom p-4 border-0 shadow-sm">
                <h5 class="fw-bold text-secondary mb-3">รายชื่อผู้ใช้งานทั้งหมด</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>ชื่อผู้ใช้</th>
                                <th>ชื่อ - นามสกุล</th>
                                <th>สิทธิ์</th>
                                <th>สถานะ</th>
                                <th>จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int index = 1;
                                foreach (var user in Model)
                                {
                                    <tr>
                                        <td>@(index++)</td>
                                        <td class="fw-bold text-success">@user.Username</td>
                                        <td>@(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)</td>
                                        <td><span class="badge bg-primary">@user.Role</span></td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">ใช้งานปกติ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">ระงับการใช้งาน</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('ยืนยันการลบผู้ใช้คนนี้?');">
                                                <i class="bi bi-trash"></i> ลบ
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">ยังไม่มีข้อมูลผู้ใช้งานในระบบ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>